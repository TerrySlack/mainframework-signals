{
  "name": "@mainframework/signals",
  "version": "4.0.1",
  "description": "Signals library",
  "types": "./dist/index.d.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerrySlack/mainframework-signals.git"
  },
  "bugs": {
    "url": "https://github.com/TerrySlack/mainframework-signals/issues"
  },
  "homepage": "https://github.com/TerrySlack/mainframework-signals#readme",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf dist",
    "lint": "eslint . --max-warnings=0 --fix",
    "lint-staged": "lint-staged",
    "prebuild": "pnpm clean",
    "build": "rollup -c && tsc --emitDeclarationOnly",
    "tscheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "typescript",
    "signals"
  ],
  "author": "Terry Slack",
  "license": "MIT",
  "lint-staged": {
    "*.(ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@mainframework/is-deep-equal": "^1.1.1",
    "@mainframework/timer": "1.1.0"
  }
}
